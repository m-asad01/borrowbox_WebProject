<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BorrowBox</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body>

    <partial name="_Navbar" />

    <form id="tokenForm">@Html.AntiForgeryToken()</form>

    @if (TempData["Message"] != null || TempData["Error"] != null)
    {
        <div class="container mt-3">
            @if (TempData["Message"] != null)
            {
                <div class="alert alert-success mb-0">@TempData["Message"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger mb-0">@TempData["Error"]</div>
            }
        </div>
    }

    <div class="container mt-3" id="ajaxMessage"></div>

    @RenderSection("Hero", required: false)

    <main>
        @RenderBody()
    </main>

    @if (ViewData["BigFooter"] != null)
    {
        <partial name="_FooterBig" />
    }
    else
    {
        <partial name="_FooterSimple" />
    }

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function showMessage(text, success) {
            var type = success ? "alert-success" : "alert-danger";
            $("#ajaxMessage").html('<div class="alert ' + type + ' mb-0">' + text + '</div>');
            window.scrollTo(0, 0);
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>