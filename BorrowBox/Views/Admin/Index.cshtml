@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-4">

    <div class="mb-4">
        <h2 class="mb-1">Admin Dashboard</h2>
        <p class="text-muted mb-0">Overview of the BorrowBox platform.</p>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-lg-3 col-sm-6">
            <div class="stat-card">
                <div class="stat-icon"><i class="bi bi-people"></i></div>
                <div>
                    <h3>@Model.TotalUsers</h3>
                    <small>Total Users</small>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-sm-6">
            <div class="stat-card">
                <div class="stat-icon blue"><i class="bi bi-box-seam"></i></div>
                <div>
                    <h3>@Model.TotalListings</h3>
                    <small>Total Listings</small>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-sm-6">
            <div class="stat-card">
                <div class="stat-icon"><i class="bi bi-arrow-left-right"></i></div>
                <div>
                    <h3>@Model.ActiveRequests</h3>
                    <small>Active Requests</small>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-sm-6">
            <div class="stat-card">
                <div class="stat-icon red"><i class="bi bi-flag"></i></div>
                <div>
                    <h3>@Model.ReportedCount</h3>
                    <small>Reported Items</small>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4" id="users">
        <div class="card-body">
            <h5 class="mb-3">Users</h5>
            <div class="table-responsive">
                <table class="table table-clean align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Listings</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model.Users)
                        {
                            <tr>
                                <td>@u.FullName</td>
                                <td>@u.Email</td>
                                <td>@u.ListingsCount</td>
                                <td>
                                    @if (u.IsBlocked)
                                    {
                                        <span class="tag tag-blocked">Blocked</span>
                                    }
                                    else
                                    {
                                        <span class="tag tag-active">Active</span>
                                    }
                                </td>
                                <td>
                                    <form asp-controller="Admin" asp-action="ToggleBlock" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@u.Id" />
                                        @if (u.IsBlocked)
                                        {
                                            <button type="submit" class="btn btn-outline-primary btn-sm">Unblock</button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-outline-secondary btn-sm">Block</button>
                                        }
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (!Model.Users.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted">No users yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card mb-4" id="listings">
        <div class="card-body">
            <h5 class="mb-3">All Listings</h5>
            <div class="table-responsive">
                <table class="table table-clean align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th>Owner</th>
                            <th>Type</th>
                            <th>Price</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr id="item-@item.Id">
                                <td>@item.Title</td>
                                <td>@item.OwnerName</td>
                                <td><span class="tag @(item.ListingType == "Rent" ? "tag-rent" : "tag-borrow")">@item.ListingType</span></td>
                                <td>
                                    @if (item.ListingType == "Rent")
                                    {
                                        <span>Rs. @item.PricePerDay.ToString("0") / day</span>
                                    }
                                    else
                                    {
                                        <span>Free</span>
                                    }
                                </td>
                                <td>
                                    <button type="button" class="btn btn-outline-secondary btn-sm btn-remove" data-id="@item.Id">Remove</button>
                                </td>
                            </tr>
                        }
                        @if (!Model.Items.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted">No listings yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card" id="reports">
        <div class="card-body">
            <h5 class="mb-3">Reported Items</h5>
            <div class="table-responsive">
                <table class="table table-clean align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th>Owner</th>
                            <th>Reason</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var report in Model.Reports)
                        {
                            <tr class="report-of-@report.ItemId">
                                <td>@report.ItemTitle</td>
                                <td>@report.OwnerName</td>
                                <td>@report.Reason</td>
                                <td>
                                    <a asp-controller="Home" asp-action="Index" asp-route-search="@report.ItemTitle" class="btn btn-outline-primary btn-sm">View</a>
                                    <button type="button" class="btn btn-outline-secondary btn-sm btn-remove" data-id="@report.ItemId">Remove</button>
                                </td>
                            </tr>
                        }
                        @if (!Model.Reports.Any())
                        {
                            <tr><td colspan="4" class="text-center text-muted">No reported items.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        var removeUrl = '@Url.Action("RemoveItem", "Admin")';

        $(document).on("click", ".btn-remove", function () {
            var id = $(this).data("id");

            if (!confirm("Remove this item?")) {
                return;
            }

            var token = $("#tokenForm input[name='__RequestVerificationToken']").val();

            $.ajax({
                url: removeUrl,
                type: "POST",
                data: { id: id, __RequestVerificationToken: token },
                success: function (result) {
                    if (result.success) {
                        $("#item-" + id).remove();
                        $(".report-of-" + id).remove();
                    }
                    showMessage(result.message, result.success);
                },
                error: function () {
                    showMessage("Something went wrong. Please try again.", false);
                }
            });
        });
    </script>
}